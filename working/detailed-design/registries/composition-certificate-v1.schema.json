{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NFF98/appf2-design/blob/main/working/detailed-design/registries/composition-certificate-v1.schema.json",
  "title": "BD-026 generated F04 CompositionCertificateV1, proposed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "registry_digest",
    "validator_registry_digest",
    "runtime_registry_digest",
    "profile_digest",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "validator_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "patterns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "roles",
          "operators",
          "fixture_digests",
          "limits"
        ],
        "properties": {
          "kind": {
            "enum": [
              "DISPLAY",
              "FORM",
              "ARITHMETIC",
              "RECORD_LIST"
            ]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "capability_ref",
                "execution_contract_digest"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "capability_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                    }
                  }
                },
                "execution_contract_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "operators": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 38,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,49}$"
            }
          },
          "fixture_digests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_modules",
              "max_fields",
              "max_list_items"
            ],
            "properties": {
              "max_modules": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "max_fields": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              },
              "max_list_items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
